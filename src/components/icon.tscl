{{-- Inline stroke icons (24px grid, Lucide-style). Decorative: hidden from screen readers. --}}
@input name: 'pencil' | 'plus' | 'clock' | 'alert' | 'inbox' | 'database'

<svg class="icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  @if (name === 'pencil') {
    <path d="M17 3a2.85 2.85 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" />
  } @else if (name === 'plus') {
    <path d="M12 5v14" /><path d="M5 12h14" />
  } @else if (name === 'clock') {
    <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
  } @else if (name === 'alert') {
    <circle cx="12" cy="12" r="10" /><path d="M12 8v4" /><path d="M12 16h.01" />
  } @else if (name === 'inbox') {
    <path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z" />
  } @else {
    <ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14a9 3 0 0 0 18 0V5" /><path d="M3 12a9 3 0 0 0 18 0" />
  }
</svg>

<style scoped>
  :scope { flex: none; vertical-align: -0.125em; }
</style>
